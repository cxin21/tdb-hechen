# ═══ Caddy 反代 · 唯一公网入口 ═══
# ── 域名版（推荐，Let's Encrypt 自动签发续期）──────────────
{$CADDY_DOMAIN} {
	encode zstd gzip

# 2026-11-01 DSH 特化 Wave 2B：proxy（8096）整包退场，公网入口直指 MemoryCore 网关（ADR-0020）。
	# DSH 插件直连 core 的 /v3/*，鉴权由 core 的 tdai apikey 承担。
	handle {
		reverse_proxy core:8420
	}
}

# Panel（TMC 管控台）不对公网暴露：
#   服务器上 SSH 隧道访问 → ssh -L 8123:panel:8123 <server>
#   浏览器开 http://127.0.0.1:8123
# 若必须公网访问 Panel，取消下行注释并自行加 IP 白名单/BasicAuth：
# panel.{$CADDY_DOMAIN} {
# 	reverse_proxy panel:8123
# }

