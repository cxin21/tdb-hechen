# /opt/tdai/etc/env —— systemd EnvironmentFile（tdai-core/panel/proxy/knowledge 共用）
# 服务器权限：600 tdai:tdai。真实密钥只放服务器本文件，绝不提交仓库。
# 占位值仅示意格式，部署时替换为真实生成的密钥。

# 内核 gateway 鉴权 key（tdai-core server.apiKey / proxy skill+tdai serviceToken / Panel api_key 同源）
TDAI_GATEWAY_API_KEY=<REPLACE_WITH_GATEWAY_API_KEY>

# 同一个 key 的「出站」别名（**名字不同，少一个下划线**，不是笔误）：
# MemoryProxy 出站鉴权统一走 resolveBearerToken（MemoryProxy/src/tdai/bearer-token.ts:47-52），
# 解析顺序 = env TDAI_GATEWAY_APIKEY > yaml tdai.apiKey > 各链路 serviceToken。
# 2026-10-26 审计：本模板此前只有 TDAI_GATEWAY_API_KEY，而 proxy 读的是 TDAI_GATEWAY_APIKEY
#   → 只按模板部署时 yaml tdai.apiKey/serviceToken 若留空，skill/knowledge/meta/memory 四条
#     出站链路全部 401（且只在调用时报错，启动不报）。两个都写，值相同。
TDAI_GATEWAY_APIKEY=<REPLACE_WITH_GATEWAY_API_KEY>

# 上游 LLM API Key —— deprecated（ADR-0006）：LLM 秘密字段运行时唯一 SoT =
# 各服务 admin settings（{dataDir}/config-override.json）；本 env 仅作灰度回退通道。
TDAI_LLM_API_KEY=<REPLACE_WITH_LLM_API_KEY>

# 数据目录单一真源（**必填**）：MemoryCore 的 dataDir，也是 Panel「召回日志」读面的锚点。
# Panel 的 /chat-memory/recall-journal 解析序 = TDAI_RECALL_JOURNAL_DIR（显式覆盖）
#   > TDAI_DATA_DIR + /logs/recall（与 core writer 同源）；两者都缺 → 503
#   RECALL_JOURNAL_DIR_UNRESOLVED（loud，不静默读空）。值与 core yaml data.baseDir 保持一致。
TDAI_DATA_DIR=/data/tdai-memory
# 可选：journal 不在 dataDir 下时显式指定（优先级高于上面派生）
# TDAI_RECALL_JOURNAL_DIR=/data/tdai-memory/logs/recall

# Context Proxy 管理面 key（建议 openssl rand -hex 32 生成）
# 注意变量名：proxy 进程实际读取的是 **TDAI_PROXY_ADMIN_API_KEY**（MemoryProxy/src/config.ts:716，
# 优先级 env > yaml admin.apiKey > 默认 ""＝运维口公开）。PROXY_ADMIN_API_KEY 是
# docker-compose 里的别名（compose 负责改名），**原生 systemd 部署不读它** —— 只写这个名字
# 会让运维口静默变成公开可访问。
PROXY_ADMIN_API_KEY=<REPLACE_WITH_ADMIN_API_KEY_HEX64>
TDAI_PROXY_ADMIN_API_KEY=<REPLACE_WITH_ADMIN_API_KEY_HEX64>

# Knowledge 服务间鉴权 key：KS 校验侧 KNOWLEDGE_SERVICE_KEY / Panel 调用侧 KNOWLEDGE_AUTH_TOKEN 同值。
# 本腿是 systemd EnvironmentFile（tdai-knowledge 与 tdai-panel 都读本文件），**没有自动生成脚本**：
#   留空 = KS 不启用鉴权（写/管理面全部敞开），Panel 也没有 Bearer 可带；
#   与 deploy/global-images 的 .env 不同 —— 那边留空会由启动脚本生成并回写，这里必须人工填。
# 生成：openssl rand -hex 24 得到 48 位 hex（可直接用，或加 ks-svc- 前缀）；两个变量写相同的值。
# 启用后：写/管理端点（ingest、wiki 写、code-graph 写、llm-binding、admin/settings、auto-sync/trigger）
#   → 缺 Bearer 一律 401；只读查询面（tools/list、tools/call、wiki|code-graph 查询、GET auto-sync/status）不受影响。
KNOWLEDGE_SERVICE_KEY=<REPLACE_WITH_KNOWLEDGE_SERVICE_KEY>
KNOWLEDGE_AUTH_TOKEN=<REPLACE_WITH_KNOWLEDGE_SERVICE_KEY>

# 日志级别（debug/info）
MEMORY_LOG_LEVEL=debug
