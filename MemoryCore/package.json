{
  "name": "@tencentdb-agent-memory/memory-tencentdb-v2",
  "version": "2.0.0-beta.1",
  "description": "Four-layer local memory system plugin for DeepSeek Harness — auto-captures, structures, and profiles conversational knowledge using local LLM + SQLite vector search (L0→L1→L2→L3 pipeline)",
  "type": "module",
  "bin": {
    "read-local-memory": "./bin/read-local-memory.mjs"
  },
  "scripts": {
    "build": "npm run build:scripts",
    "build:scripts": "npm run build:read-local-memory",
    "prepack": "npm run build",
    "migrate-sqlite-to-tcvdb": "node ./bin/migrate-sqlite-to-tcvdb.mjs",
    "export-tencent-vdb": "node ./bin/export-tencent-vdb.mjs",
    "build:read-local-memory": "tsc --project scripts/read-local-memory/tsconfig.json",
    "read-local-memory": "node ./bin/read-local-memory.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:gate": "node scripts/typecheck-gate.mjs",
    "typecheck:baseline": "node scripts/typecheck-gate.mjs --update",
    "typecheck:gate:test": "node --test scripts/typecheck-gate.test.mjs",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs",
    "test:oss": "vitest run -c vitest.oss.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:skill-isolation": "bash scripts/ci/check-skill-queue-isolation.sh",
    "smoke:skill:llm": "tsx scripts/smoke-skill/smoke-skill-llm.ts",
    "smoke:skill:manage": "tsx scripts/smoke-skill/smoke-skill-manage.ts",
    "smoke:skill:extract": "tsx scripts/smoke-skill/smoke-skill-extract.ts",
    "smoke:skill:router": "tsx scripts/smoke-skill/smoke-skill-router.ts",
    "smoke:skill:inject": "tsx scripts/smoke-skill/smoke-skill-inject.ts",
    "smoke:skill:all": "tsx scripts/smoke-skill/smoke-skill-all.ts",
    "memory:metrics": "tsx scripts/memory-metrics.ts",
    "memory:observe": "tsx scripts/memory-observation.ts",
    "e2e:memory-prompt:vdb-cos": "tsx scripts/e2e-memory-prompt-vdb-cos.ts",
    "analyze:anchor-shadow": "tsx scripts/analyze-anchor-shadow.ts",
    "warmup:reranker": "tsx scripts/warmup-reranker.ts",
    "judge:behavior": "tsx scripts/run-behavior-judge.ts",
    "judge:behavior:smoke": "tsx scripts/persona-eval/run-persona-eval.ts --subset smoke",
    "judge:behavior:full": "tsx scripts/persona-eval/run-persona-eval.ts --subset full",
    "judge:behavior:drift": "tsx scripts/persona-eval/run-persona-eval.ts --subset full --drift 8",
    "import:opik": "tsx scripts/import-opik-to-memory-core/index.ts",
    "bench:memory": "node --import tsx scripts/eval-memory-bench.mjs",
    "audit:e3:build": "node scripts/audit/r143-e3-review.mjs build",
    "audit:e3:summarize": "node scripts/audit/r143-e3-review.mjs summarize"
  },
  "files": [
    "bin/read-local-memory.mjs",
    "scripts/read-local-memory/dist/",
    "src",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "!src/integrations/",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/__tests__/"
  ],
  "keywords": [
    "memory",
    "ai-memory",
    "long-term-memory",
    "vector-search",
    "sqlite-vec",
    "llm",
    "conversation",
    "persona",
    "scene-extraction",
    "embedding"
  ],
  "author": "TencentDB Agent Memory Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.75",
    "@huggingface/transformers": "^4.3.1",
    "@node-rs/jieba": "^2.0.1",
    "@tencentdb-agent-memory/tcvdb-text": "^0.1.1",
    "ai": "^6.0.164",
    "dayjs": "^1.11.20",
    "fflate": "^0.8.3",
    "js-tiktoken": "^1.0.18",
    "js-yaml": "^4.2.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "sqlite-vec": "0.1.7-alpha.2",
    "tsx": "^4.21.0",
    "undici": "^8.1.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "node-llama-cpp": "^3.16.2"
  },
  "peerDependenciesMeta": {
    "node-llama-cpp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kubb/cli": "^4.37.7",
    "@kubb/core": "^4.37.7",
    "@kubb/plugin-oas": "^4.37.7",
    "@kubb/plugin-ts": "^4.37.7",
    "@kubb/plugin-zod": "^4.37.7",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
