{
  "name": "@tdb/agemem-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "TDB Agemem native memory plugin for DeepSeek Harness: session head pack, per-turn volatile block, turn writeback outbox, recall tool.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js"
  },
  "files": [
    "dist",
    "client",
    "cordis.bundle.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": [
        "cordis.bundle.yml"
      ]
    }
  },

  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:v3": "node scripts/smoke-v3.mjs"
  }
}
