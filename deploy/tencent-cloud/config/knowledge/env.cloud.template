# MemoryKnowledge /opt/tdai/td-agemem/MemoryKnowledge/.env 云端模板
# 部署：cp deploy/tencent-cloud/config/knowledge/.env.cloud.template /opt/tdai/td-agemem/MemoryKnowledge/.env
# 真实密钥只放服务器本文件（600 tdai:tdai），绝不提交仓库。

PORT=8421
API_PREFIX=/v3
LOG_LEVEL=info
KNOWLEDGE_DATA_DIR=/opt/tdai/data/knowledge
KNOWLEDGE_DB_PATH=/opt/tdai/data/knowledge/knowledge.db

# LLM：直连火山方舟（Ark）
LLM_MODE=custom
LLM_PROVIDER=custom
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=<REPLACE_WITH_LLM_API_KEY>
LLM_MODEL=ark-code-latest
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# 对外地址：替换 <your-server-ip> 为服务器公网 IP
KNOWLEDGE_API_URL=http://localhost:8421
KNOWLEDGE_PUBLIC_BASE_URL=http://<your-server-ip>:8421/v3
TMC_CALLBACK_URL=http://127.0.0.1:8123

KNOWLEDGE_CLICKHOUSE_ENABLED=false

# 服务间鉴权 key：非空 = /v3 写/管理面要求 Authorization: Bearer <key>（只读白名单：tools/list、
# tools/call、wiki|code-graph 查询、GET auto-sync/status 仍开放）；留空 = 不启用（内网信任）。
# /health、/docs、/openapi.json 挂在 /v3 之外，不受本 key 影响。
# 注意：systemd 的 EnvironmentFile=/opt/tdai/etc/env 优先于本 dotenv；两侧都写时以 env 文件为准，
# Panel 调用侧 KNOWLEDGE_AUTH_TOKEN 只能来自 env 文件（Panel 不读本 dotenv）。
# 建议 openssl rand -hex 24 生成后填入，env 文件里两个变量写同一个值。
KNOWLEDGE_SERVICE_KEY=
